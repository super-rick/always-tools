{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "always-tools",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
